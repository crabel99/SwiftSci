--- a/Sources/SwiftLLM/Core/LLMModel.swift
+++ b/Sources/SwiftLLM/Core/LLMModel.swift
@@ -116,3 +116,17 @@ public protocol LLMModel: Sendable {
     /// - Returns: An AsyncStream of string segments generated by the model.
     func generate(prompt: String, options: LLMOptions) async throws -> AsyncStream<String>
 }
+
+/// A local model that reports exact completion metadata and streaming failures.
+///
+/// Successful iteration yields text chunks followed by exactly one completion record
+/// and normal stream termination. Length and cancellation are valid completion reasons.
+/// A throwing or consumer-cancelled stream need not deliver a completion record.
+public protocol CompletionReportingLLMModel: LLMModel {
+    /// Generates text and a final record containing the producer's token counts and stop reason.
+    /// - Parameters:
+    ///   - prompt: The starting text prompt.
+    ///   - options: Configuration options for generation.
+    /// - Returns: Text chunks followed by one final completion record on normal termination.
+    func generateDetails(prompt: String, options: LLMOptions) -> AsyncThrowingStream<GenerationEvent, any Error>
+}
