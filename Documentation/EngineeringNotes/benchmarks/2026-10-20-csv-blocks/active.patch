+private enum CSVFieldStorage: Sendable {
+    case flat([PackedCSVField])
+    case blocked([[PackedCSVField]])
+
+    subscript(index: Int) -> PackedCSVField {
+        switch self {
+        case .flat(let values): return values[index]
+        case .blocked(let blocks): return blocks[index >> 14][index & 16383]
+        }
+    }
+}
+
+internal struct CSVFieldBlocks {
+    private var completed = [[PackedCSVField]]()
+    private var current = [PackedCSVField]()
+    private(set) var count = 0
+
+    init(byteCount: Int) {
+        current.reserveCapacity(min(byteCount / 8, 16384))
+    }
+
+    mutating func append(_ field: PackedCSVField) {
+        if current.count == 16384 {
+            completed.append(current)
+            current = []
+            current.reserveCapacity(16384)
+        }
+        current.append(field)
+        count += 1
+    }
+
+    mutating func truncate(to newCount: Int) {
+        while count > newCount {
+            if current.isEmpty { current = completed.removeLast() }
+            let removed = min(count - newCount, current.count)
+            current.removeLast(removed)
+            count -= removed
+        }
+    }
+
+    func finished() -> [[PackedCSVField]] {
+        var result = completed
+        if !current.isEmpty { result.append(current) }
+        return result
+    }
+}
