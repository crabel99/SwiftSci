diff --git a/Examples/NumericalWorkflow/README.md b/Examples/NumericalWorkflow/README.md
new file mode 100644
index 0000000000..2e9acb2b0e
--- /dev/null
+++ b/Examples/NumericalWorkflow/README.md
@@ -0,0 +1,93 @@
+# Run a complete numerical workflow
+
+This example reads CSV data, fits preprocessing and a classifier on training rows,
+then exports held-out predictions with their original row positions. It uses the
+public APIs in SwiftDataFrame, SwiftPreprocessing, SwiftCluster, SwiftML and
+SwiftOptimize. ArgumentParser provides the command-line interface.
+
+## Run the bundled sample
+
+Use Apple silicon macOS 14 or later with Xcode selected. From the repository root:
+
+```sh
+swift run -c release ScientificWorkflow --output .build/numerical-workflow
+python3 Examples/NumericalWorkflow/verify.py .build/numerical-workflow
+```
+
+The executable prints the training/test counts, held-out accuracy and two output
+paths. The verifier checks the bundled sample independently and prints a JSON
+result. Python is needed only for this optional verification step.
+
+The sample's first output lines are:
+
+```text
+Training rows: 8; held-out rows: 4
+Held-out accuracy: 1.0
+```
+
+The linked MLX dependency still needs an accessible Metal environment even though
+this example requests CPU execution. A headless or restricted launch can fail
+before the workflow starts. Normal CI builds compile the example; full numerical
+execution is qualified on an Apple silicon Mac with Metal access.
+
+## Follow the stages
+
+1. Read `Data/sample.csv` with compact Double storage. The named features are
+   `signal`, `companion` and `constant`; `class` is a separate binary target.
+2. Select features and targets together using `PreparedSupervisedBatch`. The first
+   two thirds of the rows train the model. The remaining rows are queried in
+   reverse order, making source-row alignment visible.
+3. Fit `Imputer` on training features and reuse its mean replacements for both
+   sets. The sample contains one missing cell and one numeric NaN. Both receive
+   the fitted replacement, while the original source snapshot stays unchanged.
+4. Fit `StandardScaler` on imputed training features. Reuse its parameters for
+   held-out features, including the sample's constant column.
+5. Fit two-component CPU `PCA` on scaled training features. Transform held-out
+   features using that fitted state.
+6. Fit CPU `LogisticRegression` on prepared training scores and their selected
+   targets, using 64 updates at learning rate 0.125. Predict labels and both class
+   probabilities from the held-out score batch.
+7. Associate the returned arrays with `queryScores.originalRowIndices`, evaluate
+   `Metrics.accuracy` and export a DataFrame with `writeCSV`.
+
+No learned stage is fitted on held-out rows, and the target never enters feature
+preprocessing. The PCA-to-classifier handoff stays prepared. Diagnostic row
+exports are made afterwards for the JSON stage report.
+
+## Inspect the results
+
+`predictions.csv` contains `source_row`, `actual`, `predicted`,
+`probability_class_0` and `probability_class_1`. Source rows are zero-based data-row
+positions, excluding the header. They are positions in this input snapshot,
+not business identifiers. The bundled sample has eight training rows and four
+held-out rows, exported in source order 11, 10, 9, 8.
+
+`report.json` contains fitted imputation/scaling parameters, PCA components and
+variance, stage values, classifier weights, probabilities, row selections and
+accuracy. JSON represents missing values and NaNs as `null` in the diagnostic
+raw rows; separate counters retain their distinction.
+
+The verifier independently computes training-only preprocessing, a closed-form
+two-feature PCA eigensystem and scalar logistic updates. It checks both output
+files with `abs(error) <= 1e-12 + 1e-12 * abs(reference)`, allowing PCA sign changes.
+It validates this bundled fixture, not arbitrary replacement datasets.
+
+## Use another CSV
+
+```sh
+swift run -c release ScientificWorkflow --input /path/to/data.csv --output .build/my-results
+```
+
+Provide the same four named numeric columns and at least six data rows. Every
+`class` value must be 0 or 1 and the training portion must contain both classes.
+Missing or NaN features are imputed; infinite features and invalid labels need
+correction in the input. Change the feature names, row selection, PCA width or
+training settings in `ScientificWorkflow.swift` for a different problem.
+
+Each successful run replaces only `predictions.csv` and `report.json` in the
+chosen directory. Use `swift run ScientificWorkflow --help` for the CLI options.
+
+The small sample and ordered split demonstrate integration. Their accuracy does
+not measure generalization on a representative dataset. This example makes no
+speed, accelerator-placement or memory-bound claim; the stage report retains
+additional diagnostic arrays.
diff --git a/Examples/NumericalWorkflow/ScientificWorkflow.swift b/Examples/NumericalWorkflow/ScientificWorkflow.swift
new file mode 100644
index 0000000000..8c0b652b79
--- /dev/null
+++ b/Examples/NumericalWorkflow/ScientificWorkflow.swift
@@ -0,0 +1,144 @@
+import ArgumentParser
+import Foundation
+import SwiftDataFrame
+import SwiftPreprocessing
+import SwiftCluster
+import SwiftML
+import SwiftOptimize
+
+@main
+struct ScientificWorkflow: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(
+        commandName: "ScientificWorkflow",
+        abstract: "Run a CSV-to-predictions SwiftSci numerical workflow."
+    )
+
+    @Option(help: "CSV with signal, companion, constant and binary class columns; defaults to the bundled sample.")
+    var input: String?
+
+    @Option(help: "Directory for predictions.csv and report.json; those two files are replaced on each run.")
+    var output = ".build/numerical-workflow"
+
+    func run() async throws {
+        let inputURL: URL
+        if let input {
+            inputURL = URL(fileURLWithPath: input)
+        } else {
+            guard let bundled = Bundle.module.url(forResource: "sample", withExtension: "csv", subdirectory: "Data") else {
+                throw ValidationError("The bundled sample.csv resource is missing.")
+            }
+            inputURL = bundled
+        }
+        let directory = URL(fileURLWithPath: output, isDirectory: true)
+        let csvURL = directory.appendingPathComponent("predictions.csv")
+        let jsonURL = directory.appendingPathComponent("report.json")
+        let resolvedInput = inputURL.resolvingSymlinksInPath().standardizedFileURL
+        guard ![csvURL, jsonURL].contains(where: {
+            $0.resolvingSymlinksInPath().standardizedFileURL == resolvedInput
+        }) else {
+            throw ValidationError("Choose an output directory that does not overwrite the input CSV.")
+        }
+
+        var options = CSVReadOptions()
+        options.doubleStorage = .compact
+        // Keep a numeric NaN distinct from a missing CSV cell. Both are imputed below.
+        options.nullValues.remove("NaN")
+        options.nullValues.remove("nan")
+        let frame = try await DataFrame(csv: inputURL, options: options)
+        let source = try frame.prepareNumericBatch(["signal", "companion", "constant", "class"])
+        guard source.rowCount >= 6 else {
+            throw ValidationError("This example needs at least six data rows for its training/test split.")
+        }
+        let supervised = try PreparedSupervisedBatch(source, targetColumn: "class")
+        guard supervised.targets.allSatisfy({ $0 == 0 || $0 == 1 }) else {
+            throw ValidationError("Every class value must be 0 or 1, without missing values.")
+        }
+        let features = supervised.features
+        let rawColumns = (0..<features.columnCount).map { features.columnValues(at: $0) }
+        guard !rawColumns.contains(where: { $0.contains(where: { $0?.isInfinite == true }) }) else {
+            throw ValidationError("Feature values may be missing or NaN, but must not be infinite.")
+        }
+        let originalBits = (0..<source.columnCount).map { source.columnValues(at: $0).map { $0?.bitPattern } }
+
+        // Select features and targets together before any learned stage is fitted.
+        let trainingCount = source.rowCount * 2 / 3
+        let trainingIDs = Array(0..<trainingCount)
+        let queryIDs = Array((trainingCount..<source.rowCount).reversed())
+        let training = try supervised.selectingRows(trainingIDs)
+        let query = try supervised.selectingRows(queryIDs)
+        guard Set(training.targets) == Set([0.0, 1.0]) else {
+            throw ValidationError("The training portion must contain both class 0 and class 1.")
+        }
+
+        var imputer = Imputer(strategy: .mean)
+        try imputer.fit(training.features)
+        let imputedTraining = try imputer.transform(training.features)
+        let imputedQuery = try imputer.transform(query.features)
+        var scaler = StandardScaler()
+        try scaler.fit(imputedTraining)
+        let scaledTraining = try scaler.transform(imputedTraining)
+        let scaledQuery = try scaler.transform(imputedQuery)
+
+        // Query rows only transform and predict. The target never enters preprocessing.
+        let pca = try PCA(nComponents: 2, svdSolver: .full, device: .cpu)
+        let trainingScores = try await pca.fitTransform(scaledTraining)
+        let queryScores = try await pca.transform(scaledQuery)
+        let classifier = LogisticRegression(device: .cpu)
+        try await classifier.fit(features: trainingScores, targets: training.targets,
+                                 learningRate: 0.125, epochs: 64)
+        let probabilities = try await classifier.predictProbability(features: queryScores)
+        let predictions = try await classifier.predict(features: queryScores)
+        let actual = query.targets.map { Int($0) }
+        let accuracy = Metrics.accuracy(yTrue: actual, yPred: predictions)
+
+        guard let replacements = imputer.statistics, let means = scaler.mean, let deviations = scaler.std,
+              let pcaMean = await pca.mean, let components = await pca.components,
+              let variance = await pca.explainedVariance,
+              let weights = await classifier.getWeights(), let bias = await classifier.getBias() else {
+            throw ValidationError("The workflow did not publish its fitted state.")
+        }
+        let currentBits = (0..<source.columnCount).map { source.columnValues(at: $0).map { $0?.bitPattern } }
+        guard originalBits == currentBits, trainingScores.originalRowIndices == trainingIDs,
+              queryScores.originalRowIndices == queryIDs, probabilities.count == queryIDs.count,
+              predictions.count == queryIDs.count else {
+            throw ValidationError("Source snapshot or prediction row alignment changed.")
+        }
+
+        // Arrays do not carry row IDs. Associate each prediction with its score batch.
+        let resultFrame = try DataFrame(columns: [
+            TypedColumn<Int64>(name: "source_row", values: queryScores.originalRowIndices.map { Int64($0) }),
+            TypedColumn<Int64>(name: "actual", values: actual.map { Int64($0) }),
+            TypedColumn<Int64>(name: "predicted", values: predictions.map { Int64($0) }),
+            TypedColumn<Double>(name: "probability_class_0", values: probabilities.map { $0[0] }),
+            TypedColumn<Double>(name: "probability_class_1", values: probabilities.map { $0[1] })
+        ])
+        let rawRows: [[Any]] = (0..<source.rowCount).map { row in
+            rawColumns.map { column -> Any in
+                guard let value = column[row], value.isFinite else { return NSNull() }
+                return value
+            }
+        }
+        let report: [String: Any] = [
+            "schemaVersion": 1, "trainingSourceRows": trainingIDs, "querySourceRows": queryIDs,
+            "featureNames": features.columnNames, "scoreNames": queryScores.columnNames,
+            "rawRows": rawRows, "sourceTargets": supervised.targets,
+            "nullFeatureCount": rawColumns.flatMap { $0 }.filter { $0 == nil }.count,
+            "nanFeatureCount": rawColumns.flatMap { $0 }.filter { $0?.isNaN == true }.count,
+            "trainingTargets": training.targets, "queryTargets": query.targets,
+            "imputationStatistics": replacements, "scalingMean": means, "scalingStd": deviations,
+            "scaledTraining": scaledTraining.rowValues(), "scaledQuery": scaledQuery.rowValues(),
+            "pcaMean": pcaMean, "pcaComponents": components, "pcaVariance": variance,
+            "trainingScores": trainingScores.rowValues(), "queryScores": queryScores.rowValues(),
+            "weights": weights, "bias": bias, "probabilities": probabilities, "predictions": predictions,
+            "accuracy": accuracy, "learningRate": 0.125, "epochs": 64, "sourceSnapshotPreserved": true
+        ]
+        let json = try JSONSerialization.data(withJSONObject: report, options: [.prettyPrinted, .sortedKeys])
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        try await resultFrame.writeCSV(to: csvURL)
+        try json.write(to: jsonURL, options: .atomic)
+        print("Training rows: \(trainingIDs.count); held-out rows: \(queryIDs.count)")
+        print("Held-out accuracy: \(accuracy)")
+        print("Predictions: \(csvURL.path)")
+        print("Stage report: \(jsonURL.path)")
+    }
+}
diff --git a/Examples/NumericalWorkflow/verify.py b/Examples/NumericalWorkflow/verify.py
new file mode 100644
index 0000000000..e89529129a
--- /dev/null
+++ b/Examples/NumericalWorkflow/verify.py
@@ -0,0 +1,142 @@
+"""Independently verify the bundled numerical example's JSON and CSV outputs."""
+
+import argparse
+import csv
+import hashlib
+import json
+import math
+from pathlib import Path
+
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("output", type=Path, help="Directory containing report.json and predictions.csv")
+args = parser.parse_args()
+report_path = args.output / "report.json"
+csv_path = args.output / "predictions.csv"
+report = json.loads(report_path.read_text(encoding="utf-8"))
+errors = {}
+
+
+def close(name, actual, expected):
+    if isinstance(expected, list):
+        assert len(actual) == len(expected), (name, "shape")
+        for found, wanted in zip(actual, expected):
+            close(name, found, wanted)
+    else:
+        assert isinstance(actual, (int, float)) and not isinstance(actual, bool), (name, "numeric type")
+        assert math.isfinite(actual) and math.isfinite(expected), (name, "nonfinite")
+        difference = abs(actual - expected)
+        errors[name] = max(errors.get(name, 0), difference)
+        assert difference <= 1e-12 + 1e-12 * abs(expected), (name, actual, expected)
+
+
+def dot(left, right):
+    return math.fsum(x * y for x, y in zip(left, right))
+
+
+def sigmoid(value):
+    return 1 / (1 + math.exp(-value))
+
+
+training_ids = list(range(8))
+query_ids = [11, 10, 9, 8]
+raw = [[-4, -7, 7], [-3, -5, 7], [-2, None, 7], [-1, -1, 7],
+       [1, 2, 7], [2, 3, 7], [3, 6, 7], [4, 8, 7],
+       [-2.5, -4.5, 7], [2.5, 5, 7], [0.5, None, 7], [-0.5, 1, 7]]
+targets = [0, 0, 0, 0, 1, 1, 1, 1, 0, 1, 1, 0]
+assert report["schemaVersion"] == 1
+assert report["rawRows"] == raw and report["sourceTargets"] == targets
+assert report["trainingSourceRows"] == training_ids and report["querySourceRows"] == query_ids
+assert set(training_ids).isdisjoint(query_ids) and report["sourceSnapshotPreserved"] is True
+assert report["nullFeatureCount"] == report["nanFeatureCount"] == 1
+assert report["featureNames"] == ["signal", "companion", "constant"]
+assert report["scoreNames"] == ["PC1", "PC2"]
+assert report["trainingTargets"] == [targets[i] for i in training_ids]
+assert report["queryTargets"] == [targets[i] for i in query_ids]
+assert report["epochs"] == 64 and report["learningRate"] == 0.125
+
+# Fit independent preprocessing parameters on training rows only.
+replacements = []
+for column in range(3):
+    values = [raw[i][column] for i in training_ids if raw[i][column] is not None]
+    replacements.append(math.fsum(values) / len(values))
+imputed = [[replacements[j] if value is None else value for j, value in enumerate(row)] for row in raw]
+means = [math.fsum(imputed[i][j] for i in training_ids) / 8 for j in range(3)]
+deviations = [math.sqrt(math.fsum((imputed[i][j] - means[j]) ** 2 for i in training_ids) / 8) for j in range(3)]
+deviations = [value if value >= 1e-12 else 1 for value in deviations]
+scaled = [[(row[j] - means[j]) / deviations[j] for j in range(3)] for row in imputed]
+training = [scaled[i] for i in training_ids]
+query = [scaled[i] for i in query_ids]
+close("imputation", report["imputationStatistics"], replacements)
+close("scaling_mean", report["scalingMean"], means)
+close("scaling_std", report["scalingStd"], deviations)
+close("scaled_training", report["scaledTraining"], training)
+close("scaled_query", report["scaledQuery"], query)
+assert all(row[2] == 0 for row in report["scaledTraining"] + report["scaledQuery"])
+
+# Solve the two varying features' covariance eigensystem without a numerical library.
+pca_mean = [math.fsum(row[j] for row in training) / 8 for j in range(3)]
+centered = [[row[j] - pca_mean[j] for j in range(3)] for row in training]
+aa = math.fsum(row[0] ** 2 for row in centered) / 7
+bb = math.fsum(row[0] * row[1] for row in centered) / 7
+cc = math.fsum(row[1] ** 2 for row in centered) / 7
+discriminant = math.hypot(aa - cc, 2 * bb)
+variances = [(aa + cc + discriminant) / 2, (aa + cc - discriminant) / 2]
+assert bb != 0 and variances[0] > variances[1] > 0
+vectors = []
+for index, value in enumerate(variances):
+    vector = [bb, value - aa, 0.0]
+    length = math.sqrt(dot(vector, vector))
+    vector = [x / length for x in vector]
+    if dot(vector, report["pcaComponents"][index]) < 0:
+        vector = [-x for x in vector]
+    vectors.append(vector)
+close("pca_mean", report["pcaMean"], pca_mean)
+close("pca_variance", report["pcaVariance"], variances)
+close("pca_components", report["pcaComponents"], vectors)
+close("pca_orthogonality", dot(report["pcaComponents"][0], report["pcaComponents"][1]), 0)
+
+
+def scores(rows):
+    return [[dot([row[j] - pca_mean[j] for j in range(3)], vector) for vector in vectors] for row in rows]
+
+
+training_scores, query_scores = scores(training), scores(query)
+close("training_scores", report["trainingScores"], training_scores)
+close("query_scores", report["queryScores"], query_scores)
+
+# Use independent full-batch binary logistic updates on the independently derived scores.
+weights, bias = [0.0, 0.0], 0.0
+for _ in range(64):
+    residuals = [sigmoid(dot(row, weights) + bias) - targets[i] for i, row in enumerate(training_scores)]
+    gradients = [math.fsum(error * row[j] for error, row in zip(residuals, training_scores)) / 8 for j in range(2)]
+    weights = [weight - 0.125 * gradient for weight, gradient in zip(weights, gradients)]
+    bias -= 0.125 * math.fsum(residuals) / 8
+positive = [sigmoid(dot(row, weights) + bias) for row in query_scores]
+probabilities = [[1 - value, value] for value in positive]
+predictions = [int(value > 0.5) for value in positive]
+close("logistic_weights", report["weights"], weights)
+close("logistic_bias", report["bias"], bias)
+close("probabilities", report["probabilities"], probabilities)
+assert report["predictions"] == predictions
+accuracy = sum(prediction == targets[i] for prediction, i in zip(predictions, query_ids)) / len(query_ids)
+close("accuracy", report["accuracy"], accuracy)
+
+with csv_path.open(newline="", encoding="utf-8") as stream:
+    reader = csv.DictReader(stream)
+    assert reader.fieldnames == ["source_row", "actual", "predicted", "probability_class_0", "probability_class_1"]
+    rows = list(reader)
+assert len(rows) == len(query_ids)
+for index, row in enumerate(rows):
+    assert int(row["source_row"]) == query_ids[index]
+    assert int(row["actual"]) == targets[query_ids[index]]
+    assert int(row["predicted"]) == predictions[index]
+    for label in range(2):
+        close("csv_probability", float(row[f"probability_class_{label}"]), probabilities[index][label])
+
+sha = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()
+print(json.dumps(dict(status="passed", training_rows=8, query_source_rows=query_ids,
+                      tolerance="abs(error)<=1e-12+1e-12*abs(reference)",
+                      maximum_absolute_errors=errors, predictions=predictions, accuracy=accuracy,
+                      report_sha256=sha(report_path), csv_sha256=sha(csv_path),
+                      verifier_sha256=sha(Path(__file__))), indent=2))
