+                    throw AgentError.executionFailed("Model completion contains text after final metadata.")
+                }
+                text += chunk
+            case .info(let completion):
+                guard info == nil else {
+                    throw AgentError.executionFailed("Model completion contains multiple metadata records.")
+                }
