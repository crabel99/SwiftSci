+internal protocol CSVRecordAccess {
+    func field(row: Int, column: Int) -> CSVFieldOffset?
+}
+
+internal struct CSVFlatRecordView: CSVRecordAccess {
+    let fields: [PackedCSVField]
+    let rowStarts: [Int]
+
+    @inline(__always)
+    func field(row: Int, column: Int) -> CSVFieldOffset? {
