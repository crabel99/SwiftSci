diff --git a/Sources/SwiftCluster/Decomposition/PCAFullSVDLayout.swift b/Sources/SwiftCluster/Decomposition/PCAFullSVDLayout.swift
new file mode 100644
index 0000000000..c08c1b26dc
--- /dev/null
+++ b/Sources/SwiftCluster/Decomposition/PCAFullSVDLayout.swift
@@ -0,0 +1,39 @@
+import SwiftDataFrame
+
+struct PCAFullSVDLayout: Sendable {
+    let rows: Int32
+    let columns: Int32
+    let rank: Int
+    let leftCount: Int
+    let rightCount: Int
+    let integerWorkspaceCount: Int
+
+    init(rows: Int, columns: Int) throws {
+        guard rows > 0, columns > 0,
+              let lapackRows = Int32(exactly: rows),
+              let lapackColumns = Int32(exactly: columns) else {
+            throw ClusterError.invalidParameter("PCA SVD dimensions exceed backend limits.")
+        }
+        self.rows = lapackRows
+        self.columns = lapackColumns
+        rank = min(rows, columns)
+
+        leftCount = try Self.bufferCount(rows, rank, stride: MemoryLayout<Double>.stride)
+        rightCount = try Self.bufferCount(rank, columns, stride: MemoryLayout<Double>.stride)
+        integerWorkspaceCount = try Self.bufferCount(8, rank, stride: MemoryLayout<Int32>.stride)
+    }
+
+    private static func product(_ lhs: Int, _ rhs: Int) throws -> Int {
+        let (count, overflow) = lhs.multipliedReportingOverflow(by: rhs)
+        guard !overflow else {
+            throw ClusterError.invalidParameter("PCA SVD workspace size overflowed Int.")
+        }
+        return count
+    }
+
+    private static func bufferCount(_ rows: Int, _ columns: Int, stride: Int) throws -> Int {
+        let count = try product(rows, columns)
+        _ = try product(count, stride)
+        return count
+    }
+}
diff --git a/Tests/SwiftClusterTests/PCAFullSVDLayoutTests.swift b/Tests/SwiftClusterTests/PCAFullSVDLayoutTests.swift
new file mode 100644
index 0000000000..d31448c0ae
--- /dev/null
+++ b/Tests/SwiftClusterTests/PCAFullSVDLayoutTests.swift
@@ -0,0 +1,33 @@
+import Testing
+@testable import SwiftCluster
+
+@Suite("PCA full SVD workspace bounds")
+struct PCAFullSVDLayoutTests {
+    @Test(arguments: [[4, 3], [3, 4], [1, 1], [10, 1], [1, 10]])
+    func economyShapes(_ shape: [Int]) throws {
+        let rows = shape[0], columns = shape[1], rank = min(rows, columns)
+        let layout = try PCAFullSVDLayout(rows: rows, columns: columns)
+        #expect(layout.rows == Int32(rows) && layout.columns == Int32(columns))
+        #expect(layout.rank == rank)
+        #expect(layout.leftCount == rows * rank)
+        #expect(layout.rightCount == rank * columns)
+        #expect(layout.integerWorkspaceCount == 8 * rank)
+    }
+
+    @Test func rejectsUnsupportedDimensionsAndWorkspaceWithoutAllocation() throws {
+        for invalid in [0, -1, Int(Int32.max) + 1, Int.max] {
+            #expect(throws: ClusterError.self) { try PCAFullSVDLayout(rows: invalid, columns: 2) }
+            #expect(throws: ClusterError.self) { try PCAFullSVDLayout(rows: 2, columns: invalid) }
+        }
+        #expect(throws: ClusterError.self) {
+            try PCAFullSVDLayout(rows: Int(Int32.max), columns: Int(Int32.max))
+        }
+    }
+
+    @Test func preservesBackendSupportedLargeLayoutWithoutAllocation() throws {
+        let layout = try PCAFullSVDLayout(rows: 24_000, columns: 24_000)
+        #expect(layout.leftCount == 576_000_000)
+        #expect(layout.rightCount == 576_000_000)
+        #expect(layout.integerWorkspaceCount == 192_000)
+    }
+}
